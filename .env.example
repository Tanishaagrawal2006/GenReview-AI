# reviewflow_app/.env.example

FLASK_SECRET_KEY="replace_me_with_a_secure_random_string"
GROQ_API_KEY="YOUR_GROQ_API_KEY_HERE"

# 📨 Genuine SMTP Email Configurations
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_SENDER_EMAIL="your_email@gmail.com"
SMTP_SENDER_PASSWORD="YOUR_APP_PASSWORD_HERE"

# 🌐 PUBLIC BASE URL
# Set this to your deployed domain on Render.
# Example: BASE_URL="https://your-app-name.onrender.com"
BASE_URL="https://YOUR_DEPLOYED_DOMAIN_HERE"

# 🗄️ DATABASE (Supabase / Postgres)
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the "Transaction pooler" connection string if available, it's more
# reliable from serverless/small hosts like Render's free tier.
# Example: DATABASE_URL="postgresql://postgres:[password]@[host]:5432/postgres"
DATABASE_URL="postgresql://YOUR_SUPABASE_CONNECTION_STRING_HERE"

# 🔧 FLASK ENVIRONMENT
# Set to "production" on your live server
FLASK_ENV="production"
